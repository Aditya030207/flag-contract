{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flag Contract",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expect"],
        "dependentRequired": { "traits": ["identity"] },
        "properties": {
          "name": { "type": "string", "pattern": "\\S" },
          "identity": { "type": "string", "pattern": "\\S" },
          "traits": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          },
          "expect": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "\\S" },
            "additionalProperties": { "$ref": "#/$defs/assertion" }
          }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "present": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "value": true
      },
      "if": { "required": ["present"], "properties": { "present": { "const": false } } },
      "then": { "maxProperties": 1 }
    }
  }
}
